# ===========================================================================
# Multilingual file for the TOS 7 Docker application "victoriametricsdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language.
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations". Run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "VictoriaMetrics TSDB"
auth         = "VictoriaMetrics"
version      = "@@VERSION@@"
descript     = "VictoriaMetrics is a fast, low-memory time-series database and monitoring solution. It accepts metrics over Prometheus remote-write and the HTTP ingestion endpoints for InfluxDB line protocol, OpenTelemetry and DataDog, stores them locally, and lets you query with PromQL/MetricsQL and explore them in the built-in vmui web UI. One container, one port, data in the application data folder."
release_note = "1.157.0-1 - Rectified per review comments. C3/C4: added PRIVACY.md covering retention, user rights, security measures, third-party sharing and the deletion channel, and pointed the Help link at it. C8: documented that VictoriaMetrics has no telemetry, analytics or version check, and listed the only endpoints the package may contact. C9: corrected the description - the root page links to vmui instead of redirecting, and only the protocols this package actually accepts are listed. C10: completed README with repository layout, privacy, notices, build and data/uninstall sections, added NOTICE.md, and kept the repository public. L01/L03: all 23 language sections define name/auth/descript/release_note/important, use LF endings and contain no ASCII semicolons. P3: display name is now VictoriaMetrics TSDB, so the duplicate-name limit is respected. T1: upstream upgraded from 1.149.0 to 1.157.0 (released 20 Nov 2026) with multi-architecture images. F2: launch flags are passed under command, with the official binary pinned as the entrypoint, so PID 1 is never a flag."
important    = "Requires DockerEngine (installed automatically if missing). The web UI is at /vmui (the root page links to it). Point exporters or agents at the same port (remote-write path /api/v1/write). Retention is 12 months, configured in the package. Data lives in DockerAppData/victoriametricsdocker/data. No telemetry or version checks are sent. Plain HTTP without authentication, so use a TLS reverse proxy before exposing it to the internet."

[zh-cn]
name         = "VictoriaMetrics 时序库"
auth         = "VictoriaMetrics"
version      = "@@VERSION@@"
descript     = "VictoriaMetrics 是快速、低内存的时序数据库与监控方案。它接收 Prometheus remote-write 以及 InfluxDB、OpenTelemetry、DataDog 的 HTTP 写入，把指标保存在本地，支持用 PromQL/MetricsQL 查询，并可在内置的 vmui 网页界面中查看。单容器、单端口，数据保存在应用数据目录。"
release_note = "1.157.0-1：按审核意见整改。C3/C4：新增 PRIVACY.md，覆盖保留期、用户权利、安全措施、第三方共享与删除渠道，帮助链接指向该文档。C8：说明 VictoriaMetrics 默认无遥测、分析或版本检查，并列出包可能访问的端点。C9：修正描述——根页面是链接到 vmui 而不是重定向，只保留本包实际支持的写入协议。C10：README 补充仓库结构、隐私、声明、构建、数据与卸载章节，新增 NOTICE.md，仓库保持公开。L01/L03：23 个语言段均含完整字段，统一 LF 换行，不含 ASCII 分号。P3：显示名改为 VictoriaMetrics 时序库，避免同名超限。T1：上游从 1.149.0 升级到 1.157.0（2026-11-20 发布），多架构镜像。F2：启动参数放到 command，入口固定为官方二进制，PID 1 不再是参数。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。网页界面在 /vmui（根页面提供入口链接）。把 exporter 或 agent 指向同一端口的 remote-write 路径 /api/v1/write。保留期默认 12 个月，在包内设置。数据保存在 DockerAppData/victoriametricsdocker/data。应用不会发送遥测或版本检查。界面为纯 HTTP 且默认无鉴权，暴露到公网前请配置带 TLS 的反向代理。"

[zh-hk]
name         = "VictoriaMetrics 時序資料庫"
auth         = "VictoriaMetrics"
version      = "@@VERSION@@"
descript     = "VictoriaMetrics 是快速、低記憶體的時序資料庫與監控方案。它接收 Prometheus remote-write 以及 InfluxDB、OpenTelemetry、DataDog 的 HTTP 寫入，把指標保存在本機，支援用 PromQL/MetricsQL 查詢，並可在內建的 vmui 網頁介面中檢視。單容器、單端口，資料保存在應用資料目錄。"
release_note = "1.157.0-1：按審核意見整改。C3/C4：新增 PRIVACY.md，涵蓋保留期、使用者權利、安全措施、第三方共享與刪除管道，說明連結指向該文件。C8：說明 VictoriaMetrics 預設無遙測、分析或版本檢查，並列出套件可能存取的端點。C9：修正描述——根頁面是連結到 vmui 而不是重定向，只保留本套件實際支援的寫入協定。C10：README 補充倉庫結構、隱私、聲明、建置、資料與卸載章節，新增 NOTICE.md，倉庫保持公開。L01/L03：23 個語言區段均含完整欄位，統一 LF 換行，不含 ASCII 分號。P3：顯示名改為 VictoriaMetrics 時序資料庫，避免同名超限。T1：上游從 1.149.0 升級到 1.157.0（2026-11-20 發布），多架構映像。F2：啟動參數放到 command，入口固定為官方二進位，PID 1 不再是參數。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。網頁介面在 /vmui（根頁面提供入口連結）。把 exporter 或 agent 指向同一端口的 remote-write 路徑 /api/v1/write。保留期預設 12 個月，在包內設定。資料保存在 DockerAppData/victoriametricsdocker/data。應用不會傳送遙測或版本檢查。介面為純 HTTP 且預設無鑑權，公開到互聯網前請配置帶 TLS 的反向代理。"

[fr-fr]
name         = "VictoriaMetrics TSDB"
auth         = "VictoriaMetrics"
version      = "@@VERSION@@"
descript     = "VictoriaMetrics is a fast, low-memory time-series database and monitoring solution. It accepts metrics over Prometheus remote-write and the HTTP ingestion endpoints for InfluxDB line protocol, OpenTelemetry and DataDog, stores them locally, and lets you query with PromQL/MetricsQL and explore them in the built-in vmui web UI. One container, one port, data in the application data folder."
release_note = "1.157.0-1 - Rectified per review comments. C3/C4: added PRIVACY.md covering retention, user rights, security measures, third-party sharing and the deletion channel, and pointed the Help link at it. C8: documented that VictoriaMetrics has no telemetry, analytics or version check, and listed the only endpoints the package may contact. C9: corrected the description - the root page links to vmui instead of redirecting, and only the protocols this package actually accepts are listed. C10: completed README with repository layout, privacy, notices, build and data/uninstall sections, added NOTICE.md, and kept the repository public. L01/L03: all 23 language sections define name/auth/descript/release_note/important, use LF endings and contain no ASCII semicolons. P3: display name is now VictoriaMetrics TSDB, so the duplicate-name limit is respected. T1: upstream upgraded from 1.149.0 to 1.157.0 (released 20 Nov 2026) with multi-architecture images. F2: launch flags are passed under command, with the official binary pinned as the entrypoint, so PID 1 is never a flag."
important    = "Requires DockerEngine (installed automatically if missing). The web UI is at /vmui (the root page links to it). Point exporters or agents at the same port (remote-write path /api/v1/write). Retention is 12 months, configured in the package. Data lives in DockerAppData/victoriametricsdocker/data. No telemetry or version checks are sent. Plain HTTP without authentication, so use a TLS reverse proxy before exposing it to the internet."

